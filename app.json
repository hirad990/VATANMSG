{
  "expo": {
    "name": "پیام‌رسان وطن",
    "slug": "vatanmsg",
    "scheme": "vatanmsg",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.vatanmsg.app"
    },
    "android": {
      "package": "ir.vatanmsg.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Vatan to choose a profile photo.",
          "cameraPermission": "Allow Vatan to take a profile photo."
        }
      ],
      "expo-notifications"
    ]
  }
}
